{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://campusprep-backend.onrender.com/api/$1"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "https://campusprep-backend.onrender.com/uploads/$1"
    },
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "campusprep-backend"
      }
    }
  ],
  "services": {
    "campusprep-backend": {
      "root": ".",
      "framework": "vite",
      "buildCommand": "npm run build",
      "outputDirectory": "dist"
    }
  }
}
