# PROFESSORVIRUS CONFIGURATION TEMPLATE (.env.example)

# FRONTEND PRODUCTION API URL (Vercel Frontend -> Render Backend)
VITE_API_URL=https://campusprep-backend.onrender.com

# MONGODB ATLAS CONNECTION URI
MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@cluster0.tftgeof.mongodb.net/ProfessorVirus?appName=Cluster0

# BACKEND SERVER PORT & JWT SECRET
PORT=5000
JWT_SECRET=your_jwt_secret_key_here

# FRONTEND CORS URL
FRONTEND_URL=https://campusprep.vercel.app

# SEED ADMIN CREDENTIALS
ADMIN_EMAIL=admin@professorvirus.edu
ADMIN_PASSWORD=your_secure_admin_password
ADMIN_NAME=ProfessorVirus Administrator

# GOOGLE DRIVE OAUTH CONFIGURATION
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://campusprep-backend.onrender.com/api/google-drive/callback
GOOGLE_DRIVE_FOLDER_ID=
